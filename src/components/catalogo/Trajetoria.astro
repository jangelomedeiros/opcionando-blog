---
// "Dinâmica do lucro no tempo": resultado dia a dia até o 1º vencimento, com o preço parado, a +1σ e a −1σ.
import { trajetoria, fraseTrajetoria } from '../../lib/catalogo/trajetoria.ts';
import { segmentosPorSinal, escalas, caminho, area, type Ponto } from '../../lib/catalogo/grafico.ts';
import type { Cenario, Posicao } from '../../lib/motor/posicao.ts';
import { pct } from '../../lib/laboratorio';

interface Props { posicao: Posicao; cenario: Cenario; sigma: number }
const { posicao, cenario, sigma } = Astro.props;
const t = trajetoria(posicao, cenario, sigma);
const n = t.datas.length - 1;
const xs = t.datas.map((_, i) => i);
const caixa = { L: 44, R: 88, T: 12, B: 26, W: 560, H: 220 };
const { X, Y, yMin, yMax } = escalas(xs, [t.parado, t.alta, t.baixa], caixa);
const pts = (ys: number[]): Ponto[] => ys.map((y, i) => [i, y]);
const segs = segmentosPorSinal(xs, t.parado);
const br = (v: number) => (v < -0.0049 ? '−' : '') + Math.abs(v).toFixed(2).replace('.', ',');
const dm = (iso: string) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}`;
const marcas = [...new Set([0, Math.round(n / 2), n])];
// Rótulos no fim das linhas, afastados para não se sobreporem.
const fins = [{ k: 'parado', nome: 'parado', y: t.parado[n] }, { k: 'alta', nome: '+1σ', y: t.alta[n] }, { k: 'baixa', nome: '−1σ', y: t.baixa[n] }]
  .map((f) => ({ ...f, py: Y(f.y) })).sort((a, b) => a.py - b.py);
for (let i = 1; i < fins.length; i++) if (fins[i].py - fins[i - 1].py < 13) fins[i].py = fins[i - 1].py + 13;
---
{n >= 2 && (
  <div class="traj">
    <h3 class="mini">Dinâmica do lucro no tempo</h3>
    <svg class="traj-svg" viewBox={`0 0 ${caixa.W} ${caixa.H}`} role="img" aria-label={`Resultado por unidade, dia a dia até o primeiro vencimento, com o preço parado, subindo 1 desvio e caindo 1 desvio. ${fraseTrajetoria(t)}`}>
      <line class="g-zero" x1={caixa.L} x2={caixa.W - caixa.R} y1={Y(0)} y2={Y(0)} />
      {[yMax, yMin].filter((v) => Math.abs(v) > 0.005).map((v) => <text class="g-rot" x={caixa.L - 6} y={Y(v * 0.92) + 4} text-anchor="end">{br(v * 0.92)}</text>)}
      <text class="g-rot" x={caixa.L - 6} y={Y(0) + 4} text-anchor="end">0</text>
      {marcas.map((i) => <text class="g-rot" x={X(i)} y={caixa.H - 8} text-anchor={i === 0 ? 'start' : i === n ? 'end' : 'middle'}>{i === 0 ? `hoje ${dm(t.datas[0])}` : i === n ? `venc. ${dm(t.datas[n])}` : `${Math.max(n - i - 1, 0)} du`}</text>)}
      {segs.map((s) => <path class={s.sinal > 0 ? 'g-area-lucro' : 'g-area-prejuizo'} d={area(s.pontos, X, Y)} />)}
      <path class="traj-alta" d={caminho(pts(t.alta), X, Y)} />
      <path class="traj-baixa" d={caminho(pts(t.baixa), X, Y)} />
      {segs.map((s) => <path class={`traj-parado ${s.sinal > 0 ? 'g-lucro' : 'g-prejuizo'}`} d={caminho(s.pontos, X, Y)} />)}
      {fins.map((f) => <text class={`g-rot traj-rot-${f.k}`} x={caixa.W - caixa.R + 6} y={f.py + 4}>{f.nome} {br(f.y)}</text>)}
    </svg>
    <p class="traj-legenda"><span><i class="k-parado"></i>preço parado (o tempo sozinho)</span><span><i class="k-alta"></i>preço subindo 1σ</span><span><i class="k-baixa"></i>preço caindo 1σ</span></p>
    <p>{fraseTrajetoria(t)}</p>
    <p class="nota">Resultado por unidade a cada dia útil, com a vol das opções congelada na de entrada. Os caminhos de ±1σ abrem com a raiz do tempo, na vol realizada de {pct(sigma)}: cerca de dois terços dos pregões terminam entre eles. Para outros cenários, mova o preço, os dias e a vol no gráfico.</p>
  </div>
)}

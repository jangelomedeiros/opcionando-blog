---
import { SITE_TITLE, DISCLAIMER, LINKS } from '../consts';
const ano = new Date().getFullYear();
---
<footer>
  <div class="container-larga">
    <div class="aviso" role="note">
      <strong>Aviso importante</strong>
      <p>{DISCLAIMER}</p>
    </div>
    <div class="linha">
      <span>© {ano} {SITE_TITLE}</span>
      <span class="links">
        <a href="/sobre">Sobre</a>
        <a href="/pilares">Pilares</a>
        <a href="/rss.xml">RSS</a>
        <a href={LINKS.youtube} target="_blank" rel="noopener">YouTube</a>
        {LINKS.instagram && <a href={LINKS.instagram} target="_blank" rel="noopener">Instagram</a>}
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    background: var(--petroleo-escuro);
    color: #cfd8d9;
    padding: 2.2rem 0 1.6rem;
    font-size: 0.9rem;
  }
  .aviso {
    border: 1px solid rgba(242,105,77,0.45);
    border-radius: var(--raio);
    padding: 1rem 1.2rem;
    background: rgba(242,105,77,0.08);
  }
  .aviso strong { color: var(--coral); font-family: var(--font-titulo); font-size: 1.05rem; }
  .aviso p { margin: 0.3rem 0 0; line-height: 1.6; }
  .linha {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-top: 1.4rem;
  }
  .links { display: flex; gap: 16px; flex-wrap: wrap; }
  footer a { color: var(--creme); text-decoration: none; }
  footer a:hover { color: var(--coral); }
</style>

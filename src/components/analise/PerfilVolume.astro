---
// Volume Profile: histograma horizontal de volume por faixa de preço.
// Dados em src/data/perfil/<nome>.json com:
// { step, periodo20, periodo6, bins: [[preço, volume_mi]...], bins6: [...], poc, vah, val, poc6, vah6, val6, preco }
import { brl } from '../../lib/payoff';

interface Perfil {
  step: number; periodo20: string; periodo6: string;
  bins: [number, number][]; bins6: [number, number][];
  poc: number; vah: number; val: number; poc6: number; vah6: number; val6: number; preco: number;
}
interface Faixa { inferior: number; superior: number }
interface Props { perfil: Perfil; ticker: string; range?: Faixa; marcas?: { preco: number; rotulo: string }[] }
const { perfil: p, ticker, range, marcas = [] } = Astro.props;

const W = 540, H = 520, m = { l: 62, r: 140, t: 12, b: 34 };
const precos = p.bins.map((b) => b[0]);
const pmin = Math.min(...precos) - p.step, pmax = Math.max(...precos) + p.step;
const Y = (v: number) => m.t + ((pmax - v) / (pmax - pmin)) * (H - m.t - m.b);
const max20 = Math.max(...p.bins.map((b) => b[1])), max6 = Math.max(...p.bins6.map((b) => b[1]));
const larg = W - m.l - m.r;
const altBin = Math.max(1, Math.abs(Y(0) - Y(p.step)) - 0.6);
const X20 = (v: number) => (v / max20) * larg;
const X6 = (v: number) => (v / max6) * larg * 0.55;

const bruto = (pmax - pmin) / 10, mag = Math.pow(10, Math.floor(Math.log10(bruto)));
const passoY = [1, 2, 2.5, 5, 10].map((f) => f * mag).find((x) => x >= bruto) ?? bruto;
const marcasY: number[] = [];
for (let v = Math.ceil(pmin / passoY) * passoY; v <= pmax; v += passoY) marcasY.push(v);

const fmtPer = (s: string) => s.split('|').map((d) => d.split('-').reverse().slice(1).join('/')).join(' a ');
const linhas = [
  { y: p.vah, rot: `VAH ${brl(p.vah)}`, cls: 'va' },
  { y: p.poc, rot: `POC ${brl(p.poc)}`, cls: 'poc' },
  { y: p.val, rot: `VAL ${brl(p.val)}`, cls: 'va' },
  { y: p.poc6, rot: `POC 6m ${brl(p.poc6)}`, cls: 'poc6' },
].filter((l) => l.y >= pmin && l.y <= pmax);
// evita rótulos sobrepostos: afasta no mínimo 14 px, mantendo a ordem
const rotulos = [...linhas, ...marcas.filter((mk) => mk.preco >= pmin && mk.preco <= pmax).map((mk) => ({ y: mk.preco, rot: mk.rotulo, cls: 'marca' }))]
  .map((l) => ({ ...l, py: Y(l.y) })).sort((a, b) => a.py - b.py);
for (let i = 1; i < rotulos.length; i++) if (rotulos[i].py - rotulos[i - 1].py < 14) rotulos[i].py = rotulos[i - 1].py + 14;
const yHoje = Y(p.preco);
for (const r of rotulos) if (Math.abs(r.py - yHoje) < 13) r.py = r.py < yHoje ? yHoje - 14 : yHoje + 14;
---
<figure class="perfil">
  <figcaption class="topo">
    <strong>Volume Profile · {ticker}</strong>
    <span>Volume negociado em cada faixa de R$ {brl(p.step)}</span>
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Perfil de volume de ${ticker}`}>
    <rect x={m.l} y={Y(p.vah) - altBin / 2} width={larg} height={Y(p.val) - Y(p.vah) + altBin} class="area-valor" />
    {range && <rect x={m.l} y={Y(range.superior)} width={larg} height={Y(range.inferior) - Y(range.superior)} class="faixa" />}
    {marcasY.map((v) => <text x={m.l - 8} y={Y(v) + 4} class="rot" text-anchor="end">{brl(v)}</text>)}
    {p.bins.map(([preco, vol]) => <rect x={m.l} y={Y(preco) - altBin / 2} width={X20(vol)} height={altBin} class="b20" />)}
    {p.bins6.map(([preco, vol]) => <rect x={m.l} y={Y(preco) - altBin / 2} width={X6(vol)} height={altBin} class="b6" />)}
    {rotulos.map((l) => (
      <g class={`linha ${l.cls}`}>
        <line x1={m.l} x2={m.l + larg + 4} y1={Y(l.y)} y2={Y(l.y)} />
        <text x={m.l + larg + 8} y={l.py + 4}>{l.rot}</text>
      </g>
    ))}
    <g class="preco">
      <line x1={m.l - 4} x2={m.l + larg + 4} y1={Y(p.preco)} y2={Y(p.preco)} />
      <rect x={m.l + larg + 6} y={Y(p.preco) - 10} width="92" height="20" rx="4" />
      <text x={m.l + larg + 12} y={Y(p.preco) + 4}>hoje {brl(p.preco)}</text>
    </g>
    <text x={m.l} y={H - 10} class="rot-eixo">mais volume →</text>
  </svg>
  <figcaption class="leg">
    <span><i class="lg b20"></i>20 meses ({fmtPer(p.periodo20)})</span>
    <span><i class="lg b6"></i>6 meses ({fmtPer(p.periodo6)})</span>
    <span><i class="lg av"></i>Área de valor 20m (70% do volume)</span>
    {range && <span><i class="lg fx"></i>Range de negociação</span>}
  </figcaption>
</figure>

<style>
  .perfil { margin: 0; background: var(--bg-card); border: 1px solid var(--borda); border-radius: var(--raio); padding: 0.7rem 0.7rem 0.8rem; }
  .topo { display: flex; flex-direction: column; padding: 0 0.3rem 0.3rem; }
  .topo strong { font-family: var(--font-titulo); color: var(--destaque); font-size: 1.1rem; }
  .topo span { font-size: 0.8rem; color: var(--texto-suave); }
  svg { width: 100%; height: auto; display: block; }
  .rot { fill: var(--texto-suave); font-family: var(--font-mono); font-size: 12px; }
  .rot-eixo { fill: var(--texto-suave); font-size: 11px; }
  .area-valor { fill: rgba(14,74,85,0.07); }
  .faixa { fill: rgba(242,105,77,0.10); stroke: rgba(242,105,77,0.5); stroke-dasharray: 3 3; }
  .b20 { fill: rgba(14,74,85,0.55); }
  .b6 { fill: rgba(242,105,77,0.85); }
  @media (prefers-color-scheme: dark) { .b20 { fill: rgba(127,198,209,0.5); } .area-valor { fill: rgba(127,198,209,0.07); } }
  .linha line { stroke-width: 1.4; }
  .linha text { font-size: 11.5px; font-weight: 600; font-family: var(--font-mono); }
  .linha.poc line { stroke: var(--petroleo); } .linha.poc text { fill: var(--destaque); }
  .linha.va line { stroke: var(--petroleo); stroke-dasharray: 4 3; } .linha.va text { fill: var(--texto-suave); }
  .linha.poc6 line { stroke: var(--coral); stroke-dasharray: 4 3; } .linha.poc6 text { fill: var(--coral); }
  .linha.marca line { stroke: var(--grafite-suave); stroke-dasharray: 1 3; } .linha.marca text { fill: var(--texto-suave); font-weight: 500; }
  .preco line { stroke: var(--grafite); stroke-width: 2; }
  @media (prefers-color-scheme: dark) { .preco line { stroke: var(--texto); } }
  .preco rect { fill: var(--grafite); }
  .preco text { fill: #fff; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; }
  .leg { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 0.78rem; color: var(--texto-suave); padding: 0.3rem 0.3rem 0; }
  .lg { display: inline-block; width: 14px; height: 10px; vertical-align: middle; margin-right: 5px; border-radius: 2px; }
  .lg.b20 { background: rgba(14,74,85,0.55); } .lg.b6 { background: rgba(242,105,77,0.85); }
  .lg.av { background: rgba(14,74,85,0.12); border: 1px solid rgba(14,74,85,0.3); }
  .lg.fx { background: rgba(242,105,77,0.12); border: 1px dashed rgba(242,105,77,0.6); }
</style>

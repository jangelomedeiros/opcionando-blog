---
// Gráfico de candles estático com suportes, resistências e níveis da estrutura.
// Os dados ficam em src/data/candles/<nome>.json no formato:
// [{ "d": "2026-10-01", "o": 60.1, "h": 61.2, "l": 59.8, "c": 60.9 }, ...]
import { brl } from '../../lib/payoff';

interface Candle { d: string; o: number; h: number; l: number; c: number }
interface Nivel { preco: number; tipo: 'suporte' | 'resistencia' | 'strike'; rotulo?: string }
interface Props { candles: Candle[]; niveis?: Nivel[]; ticker: string }
const { candles, niveis = [], ticker } = Astro.props;

const W = 860, H = 380, m = { l: 12, r: 70, t: 14, b: 30 };
const lows = candles.map((c) => c.l), highs = candles.map((c) => c.h);
const precosNiveis = niveis.map((n) => n.preco);
let ymin = Math.min(...lows, ...precosNiveis), ymax = Math.max(...highs, ...precosNiveis);
const pad = (ymax - ymin) * 0.06; ymin -= pad; ymax += pad;
const n = candles.length;
const passo = (W - m.l - m.r) / n;
const X = (i: number) => m.l + passo * (i + 0.5);
const Y = (v: number) => m.t + ((ymax - v) / (ymax - ymin)) * (H - m.t - m.b);
const corpo = Math.max(1.5, passo * 0.62);

// marcações do eixo X: início de cada mês
const meses = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const marcasX = candles
  .map((c, i) => ({ i, mes: c.d.slice(5, 7), ano: c.d.slice(2, 4) }))
  .filter((c, i, arr) => i === 0 || c.mes !== arr[i - 1].mes)
  .map((c) => ({ x: X(c.i), rot: `${meses[+c.mes - 1]}/${c.ano}` }));

// marcações do eixo Y
const bruto = (ymax - ymin) / 6, mag = Math.pow(10, Math.floor(Math.log10(bruto)));
const passoY = [1, 2, 2.5, 5, 10].map((f) => f * mag).find((p) => p >= bruto) ?? bruto;
const marcasY: number[] = [];
for (let v = Math.ceil(ymin / passoY) * passoY; v <= ymax; v += passoY) marcasY.push(v);

const ultimo = candles[n - 1];
---
<figure class="candles">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Gráfico de candles de ${ticker}`}>
    {marcasY.map((v) => (
      <g>
        <line x1={m.l} x2={W - m.r} y1={Y(v)} y2={Y(v)} class="grade" />
        <text x={W - m.r + 6} y={Y(v) + 4} class="rot">{brl(v)}</text>
      </g>
    ))}
    {marcasX.map((mx) => <text x={mx.x} y={H - 8} class="rot" text-anchor="middle">{mx.rot}</text>)}

    {niveis.map((nv) => (
      <g class={`nivel ${nv.tipo}`}>
        <line x1={m.l} x2={W - m.r} y1={Y(nv.preco)} y2={Y(nv.preco)} />
        <text x={nv.tipo === 'strike' ? W - m.r - 4 : m.l + 4} y={Y(nv.preco) + (nv.tipo === 'strike' ? 14 : -5)} text-anchor={nv.tipo === 'strike' ? 'end' : 'start'}>{nv.rotulo ?? (nv.tipo === 'suporte' ? 'Suporte' : nv.tipo === 'resistencia' ? 'Resistência' : 'Strike')} {brl(nv.preco)}</text>
      </g>
    ))}

    {candles.map((c, i) => {
      const alta = c.c >= c.o;
      const topo = Y(Math.max(c.o, c.c)), base = Y(Math.min(c.o, c.c));
      return (
        <g class={alta ? 'alta' : 'baixa'}>
          <line x1={X(i)} x2={X(i)} y1={Y(c.h)} y2={Y(c.l)} class="pavio" />
          <rect x={X(i) - corpo / 2} y={topo} width={corpo} height={Math.max(base - topo, 1)} class="corpo" />
        </g>
      );
    })}

    <g class="ultimo">
      <line x1={X(n - 1)} x2={W - m.r} y1={Y(ultimo.c)} y2={Y(ultimo.c)} />
      <rect x={W - m.r + 1} y={Y(ultimo.c) - 10} width={m.r - 2} height="20" rx="4" />
      <text x={W - m.r + 6} y={Y(ultimo.c) + 4}>{brl(ultimo.c)}</text>
    </g>
  </svg>
  <figcaption>
    <span><i class="lg suporte"></i>Suporte</span>
    <span><i class="lg resistencia"></i>Resistência</span>
    <span><i class="lg strike"></i>Strikes da estrutura</span>
    <span class="fonte">{ticker} · gráfico diário · {candles[0].d.split('-').reverse().join('/')} a {ultimo.d.split('-').reverse().join('/')}</span>
  </figcaption>
</figure>

<style>
  .candles { margin: 1.6rem 0; background: var(--bg-card); border: 1px solid var(--borda); border-radius: var(--raio); padding: 0.6rem 0.6rem 0.8rem; }
  svg { width: 100%; height: auto; display: block; }
  .grade { stroke: var(--borda); stroke-width: 1; }
  .rot { fill: var(--texto-suave); font-family: var(--font-mono); font-size: 12px; }
  .alta .pavio { stroke: #1f8a5b; } .alta .corpo { fill: #1f8a5b; }
  .baixa .pavio { stroke: #d64545; } .baixa .corpo { fill: #d64545; }
  .pavio { stroke-width: 1.2; }
  .nivel line { stroke-width: 1.6; stroke-dasharray: 6 5; }
  .nivel text { font-size: 11.5px; font-weight: 600; paint-order: stroke; stroke: var(--bg-card); stroke-width: 4px; }
  .suporte line { stroke: #1f8a5b; } .suporte text { fill: #1f8a5b; }
  .resistencia line { stroke: #d64545; } .resistencia text { fill: #d64545; }
  .strike line { stroke: var(--coral); stroke-dasharray: 2 4; } .strike text { fill: var(--coral); }
  .ultimo line { stroke: var(--petroleo); stroke-dasharray: 2 3; }
  .ultimo rect { fill: var(--petroleo); }
  .ultimo text { fill: #fff; font-family: var(--font-mono); font-size: 12px; font-weight: 600; }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.8rem; color: var(--texto-suave); padding: 0.4rem 0.4rem 0; }
  .lg { display: inline-block; width: 18px; border-top: 2px dashed; vertical-align: middle; margin-right: 5px; }
  .lg.suporte { border-color: #1f8a5b; } .lg.resistencia { border-color: #d64545; } .lg.strike { border-color: var(--coral); border-top-style: dotted; }
  .fonte { margin-left: auto; font-family: var(--font-mono); }
</style>

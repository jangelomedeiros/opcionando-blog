---
import Logo from './Logo.astro';
import TemaToggle from './TemaToggle.astro';
import { SITE_TITLE, LINKS } from '../consts';
const path = Astro.url.pathname;
const ativo = (href: string) => path.startsWith(href);

const itens = [
  { href: '/comece-aqui', label: 'Comece Aqui', match: ['/comece-aqui', '/trilha'] },
  { href: '/acoes', label: 'Ações', match: ['/acoes'] },
  { href: '/analises', label: 'Análises', match: ['/analises'] },
  { href: '/macro', label: 'Macro e Micro', match: ['/macro'] },
  { href: '/estrategias', label: 'Estratégias', match: ['/estrategias'] },
  { href: '/conceitos', label: 'Conceitos', match: ['/conceitos'] },
  { href: '/supercoberta', label: 'Supercoberta', match: ['/supercoberta'] },
  { href: '/ferramentas', label: 'Ferramentas', match: ['/ferramentas'] },
  { href: '/estudos', label: 'Estudos', match: ['/estudos'] },
  { href: '/glossario', label: 'Glossário', match: ['/glossario'] },
  { href: '/artigos', label: 'Artigos', match: ['/artigos', '/blog', '/pilares', '/tags'] },
];
---
<header class="topo">
  <div class="container-larga barra">
    <a href="/" class="marca" aria-label={`${SITE_TITLE}, página inicial`}>
      <Logo size={38} />
      <span>{SITE_TITLE}</span>
    </a>
    <div class="acoes">
      <a href={LINKS.youtube} class="botao-yt" target="_blank" rel="noopener">YouTube</a>
      <TemaToggle />
    </div>
  </div>
  <nav class="container-larga menu" aria-label="Seções do site">
    {itens.map((i) => (
      <a href={i.href} class={i.match.some(ativo) ? 'ativo' : ''}>{i.label}</a>
    ))}
  </nav>
</header>

<style>
  .topo {
    background: var(--fundo);
    color: var(--titulo);
    border-bottom: 1px solid var(--borda);
  }
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    padding-bottom: 6px;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--titulo);
    text-decoration: none;
    font-family: var(--font-titulo);
    font-weight: 800;
    font-size: 1.55rem;
    letter-spacing: -0.01em;
  }
  .marca:hover { color: var(--titulo); }
  .acoes { display: flex; align-items: center; gap: 8px; flex: none; }
  .botao-yt {
    color: var(--marca-texto); text-decoration: none;
    border: 1px solid var(--marca);
    font-weight: 600; font-size: 0.88rem; padding: 6px 14px; border-radius: 999px;
  }
  .botao-yt:hover { background: var(--marca); color: var(--texto-sobre-marca); }
  .menu {
    display: flex; gap: 2px; padding-bottom: 2px;
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .menu::-webkit-scrollbar { display: none; }
  .menu a {
    flex: 0 0 auto;
    color: var(--texto-suave);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.93rem;
    padding: 8px 12px 10px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .menu a:hover { color: var(--titulo); }
  .menu a.ativo { color: var(--titulo); font-weight: 600; border-bottom-color: var(--marca); }
  @media (max-width: 520px) {
    .marca { font-size: 1.3rem; }
    .botao-yt { padding: 5px 10px; font-size: 0.82rem; }
    .menu a { padding: 8px 10px 10px; font-size: 0.9rem; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '../consts';

const posts = await getPosts();
---
<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="container">
      <p class="sobretitulo">Blog do canal</p>
      <h1>Opções sem mistério, decisão com método.</h1>
      <p class="sub">{SITE_DESCRIPTION}</p>
      <div class="acoes">
        <a class="btn primario" href={LINKS.youtube} target="_blank" rel="noopener">Assistir no YouTube</a>
        <a class="btn" href="/rss.xml">Assinar via RSS</a>
      </div>
    </div>
  </section>

  <section class="container lista">
    <h2 class="sr-only">Artigos</h2>
    {posts.length === 0 && <p>Nenhum artigo publicado ainda.</p>}
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(circle at 85% 20%, rgba(242,105,77,0.18), transparent 45%),
      var(--giz);
    border-bottom: 1px solid var(--borda);
    padding: 3.2rem 0 2.8rem;
  }
  @media (prefers-color-scheme: dark) {
    .hero { background: radial-gradient(circle at 85% 20%, rgba(242,105,77,0.15), transparent 45%), #0e262c; }
  }
  .sobretitulo {
    margin: 0; color: var(--coral); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem;
  }
  .hero h1 { margin: 0.2em 0 0.35em; }
  .sub { margin: 0; color: var(--texto-suave); font-size: 1.08rem; }
  .acoes { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1.5rem; }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 600; font-size: 0.95rem;
    padding: 10px 18px; border-radius: 999px;
    border: 2px solid var(--destaque); color: var(--destaque);
  }
  .btn:hover { border-color: var(--coral); color: var(--coral); }
  .btn.primario { background: var(--coral); border-color: var(--coral); color: #fff; }
  .btn.primario:hover { background: #ff7d63; border-color: #ff7d63; color: #fff; }
  .lista { display: grid; gap: 1.1rem; margin-top: 2.4rem; }
</style>

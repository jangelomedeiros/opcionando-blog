---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GraficoCandles from '../../components/analise/GraficoCandles.astro';
import PayoffEstrutura from '../../components/analise/PayoffEstrutura.astro';
import AvisoAnalise from '../../components/analise/AvisoAnalise.astro';
import PerfilVolume from '../../components/analise/PerfilVolume.astro';
import { getAnalises, statusAtual, classeStatus, iconeCenario, dataBR, negrito } from '../../lib/analises';
import { brl } from '../../lib/payoff';

export async function getStaticPaths() {
  const lista = await getAnalises();
  return lista.map((a) => ({
    params: { slug: a.id },
    props: { a, outras: lista.filter((x) => x.data.ticker === a.data.ticker && x.id !== a.id).slice(0, 3) },
  }));
}

const { a, outras } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const st = statusAtual(a);

// Dados do gráfico (opcionais)
const arquivos = import.meta.glob<{ default: any[] }>('../../data/candles/*.json', { eager: true });
const candles = d.grafico ? arquivos[`../../data/candles/${d.grafico}.json`]?.default : undefined;
const perfis = import.meta.glob<{ default: any }>('../../data/perfil/*.json', { eager: true });
const perfil = d.perfil ? perfis[`../../data/perfil/${d.perfil}.json`]?.default : undefined;
const tipoMapa = { resistencia: 'Resistência', suporte: 'Suporte', pivo: 'Pivô', vazio: 'Vazio de volume', preco: 'Preço' };
const sinalTxt = { alta: '▲', baixa: '▼', neutro: '■' };
let secao = 0;
const niveis = [
  ...d.suportes.map((p) => ({ preco: p, tipo: 'suporte' as const })),
  ...d.resistencias.map((p) => ({ preco: p, tipo: 'resistencia' as const })),
  ...d.estrutura.pernas.filter((p) => p.tipo !== 'acao').map((p) => ({
    preco: p.strike, tipo: 'strike' as const,
    rotulo: `${p.op === 'compra' ? 'Compra' : 'Venda'} ${p.tipo}${p.codigo ? ' ' + p.codigo : ''}`,
  })),
];
const nomeTipo = { call: 'Call', put: 'Put', acao: 'Ação' };
---
<Base title={`${d.ticker}: ${d.title}`} description={d.description} type="article"
  image={d.youtube ? `https://i.ytimg.com/vi/${d.youtube}/hqdefault.jpg` : undefined}>
  <article class="container-larga pagina">
    <p class="sobretitulo"><a href="/analises">Análise técnica dos ativos</a> · <a href={`/analises/ativo/${d.ticker.toLowerCase()}/`}>{d.ticker}</a></p>

    <header class="cab">
      <div>
        <div class="linha-ticker">
          <span class="ticker">{d.ticker}</span>
          <span class="empresa">{d.empresa}</span>
          <span class={`status ${classeStatus(st)}`}>{st}</span>
        </div>
        <h1>{d.title}</h1>
        <p class="intro">{d.description}</p>
      </div>
    </header>

    <div class="ficha">
      <div><span>Data do estudo</span><b>{dataBR(d.data)}</b></div>
      <div><span>Preço de referência</span><b>R$ {brl(d.precoReferencia)}</b></div>
      <div><span>Cenário</span><b>{iconeCenario(d.cenario)} {d.cenario}</b></div>
      <div><span>Tempo gráfico</span><b>{d.timeframe}</b></div>
      <div><span>Acompanhamento até</span><b>{dataBR(d.validade)}</b></div>
      {d.volatilidade && <div><span>Volatilidade</span><b>{d.volatilidade}</b></div>}
    </div>

    {d.veredito.length > 0 && (
      <div class="veredito">
        {d.veredito.map((v) => (
          <div class:list={['vcard', { chave: v.destaque }]}>
            <span>{v.rotulo}</span>
            <b class:list={[v.tom]}>{v.valor}</b>
            <small set:html={negrito(v.texto)} />
          </div>
        ))}
      </div>
    )}

    {candles && candles.length > 0 && <GraficoCandles candles={candles} niveis={niveis} ticker={d.ticker} range={d.range} />}

    <div class="niveis">
      {d.range && <div class="rng"><span>Range</span><b>R$ {brl(d.range.inferior)} – {brl(d.range.superior)}</b></div>}
      {d.resistencias.length > 0 && <div class="res"><span>Resistências</span>{[...d.resistencias].sort((x, y) => y - x).map((p) => <b>R$ {brl(p)}</b>)}</div>}
      {d.suportes.length > 0 && <div class="sup"><span>Suportes</span>{[...d.suportes].sort((x, y) => y - x).map((p) => <b>R$ {brl(p)}</b>)}</div>}
    </div>

    {d.indicadores.length > 0 && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Indicadores técnicos</p>
        <div class="tabela-wrap"><table class="ind">
          <thead><tr><th>Indicador</th><th>Diário</th><th>Semanal</th><th>Leitura</th></tr></thead>
          <tbody>
            {d.indicadores.map((i) => (
              <tr>
                <td><span class={`sinal ${i.sinal}`} aria-label={i.sinal}>{sinalTxt[i.sinal]}</span> <b>{i.nome}</b></td>
                <td class="num">{i.diario}</td>
                <td class="num">{i.semanal ?? '—'}</td>
                <td>{i.leitura}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
        {d.indicadoresNota && <p class="nota-bloco" set:html={negrito(d.indicadoresNota)} />}
      </section>
    )}

    {d.eventos.length > 0 && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Relação preço × volume</p>
        <ol class="eventos">
          {d.eventos.map((e) => (
            <li><span class="data">{e.data}</span><div><b>{e.evento}</b><p>{e.leitura}</p></div></li>
          ))}
        </ol>
        {d.fluxo.length > 0 && <ul class="topicos">{d.fluxo.map((f) => <li set:html={negrito(f)} />)}</ul>}
      </section>
    )}

    {(perfil || d.mapa.length > 0) && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Volume Profile e mapa de níveis</p>
        <div class="vp-grid">
          {perfil && <PerfilVolume perfil={perfil} ticker={d.ticker} range={d.range} />}
          {d.mapa.length > 0 && (
            <div class="tabela-wrap"><table class="mapa">
              <thead><tr><th>R$</th><th>Tipo</th><th>Confluência</th></tr></thead>
              <tbody>
                {d.mapa.map((n) => (
                  <tr class={n.tipo}><td class="num">{n.preco}</td><td><span class={`pill ${n.tipo}`}>{tipoMapa[n.tipo]}</span></td><td>{n.confluencia}</td></tr>
                ))}
              </tbody>
            </table></div>
          )}
        </div>
        {(d.perfilFaixas.length > 0 || d.perfilNotas.length > 0) && (
          <div class="vp-notas">
            {d.perfilFaixas.length > 0 && (
              <div class="faixas">
                <p class="rot">Volume dos 20 meses por faixa</p>
                {d.perfilFaixas.map((f) => {
                  const max = Math.max(...d.perfilFaixas.map((x) => x.pct));
                  return (
                    <div class="faixa"><span class="num">{f.faixa}</span><i style={`width:${(f.pct / max) * 100}%`}></i><b class="num">{f.pct.toLocaleString('pt-BR', { maximumFractionDigits: 1 })}%</b></div>
                  );
                })}
              </div>
            )}
            {d.perfilNotas.length > 0 && <ul class="topicos">{d.perfilNotas.map((f) => <li set:html={negrito(f)} />)}</ul>}
          </div>
        )}
      </section>
    )}

    {d.macro && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Panorama macro</p>
        <h2 class="tit-bloco">{d.macro.titulo}</h2>
        <div class="tabela-wrap"><table class="macro">
          <thead><tr><th>Ativo</th><th>Último</th><th>Dia</th><th>1M</th><th>3M</th><th>6M</th><th>Ano</th><th>Leitura</th></tr></thead>
          <tbody>
            {d.macro.tabela.map((m) => (
              <tr class:list={{ destaque: m.destaque }}>
                <td>{m.ativo}</td><td class="num">{m.ultimo}</td>
                {[m.dia ?? '—', m.m1, m.m3, m.m6, m.ano].map((x) => <td class:list={['num', { neg: m.inverte ? x.startsWith('+') : x.startsWith('−'), pos: m.inverte ? x.startsWith('−') : x.startsWith('+') }]}>{x}</td>)}
                <td>{m.efeito}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
        {d.macro.fonte && <p class="nota-bloco">{d.macro.fonte}</p>}
        {d.macro.pontos.length > 0 && <ul class="topicos">{d.macro.pontos.map((f) => <li set:html={negrito(f)} />)}</ul>}
      </section>
    )}

    {d.micro && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Panorama micro</p>
        <h2 class="tit-bloco">{d.micro.titulo}</h2>
        <div class="micro-grid">
          <div class="tabela-wrap"><table class="fund">
            <thead><tr><th>Fundamento</th><th>Valor</th></tr></thead>
            <tbody>{d.micro.fundamentos.map((f) => <tr><td>{f.nome}</td><td class="num" set:html={negrito(f.valor)} /></tr>)}</tbody>
          </table></div>
          <div>
            {d.micro.sustentacao.length > 0 && <><h3 class="pos">Fatores de sustentação</h3><ul class="topicos">{d.micro.sustentacao.map((f) => <li set:html={negrito(f)} />)}</ul></>}
            {d.micro.pressao.length > 0 && <><h3 class="neg">Fatores de pressão</h3><ul class="topicos">{d.micro.pressao.map((f) => <li set:html={negrito(f)} />)}</ul></>}
          </div>
        </div>
        {d.micro.evento && <p class="callout" set:html={negrito(d.micro.evento)} />}
      </section>
    )}

    <div class="corpo">
      <div class="texto conteudo">
        <p class="eyebrow">{++secao} · Síntese, range e estrutura</p>
        <Content />
      </div>

      <aside class="lateral">
        <section class="estrutura">
          <p class="rot">🧩 A estrutura que faz sentido</p>
          <h2>{d.estrutura.nome}</h2>
          <p class="racional">{d.estrutura.racional}</p>
          {d.estrutura.vencimento && <p class="venc">Vencimento: <b>{d.estrutura.vencimento}</b></p>}
          <table>
            <thead><tr><th>Perna</th><th>Strike</th><th>Prêmio</th><th>Qtd.</th></tr></thead>
            <tbody>
              {d.estrutura.pernas.map((p) => (
                <tr>
                  <td><span class={p.op}>{p.op === 'compra' ? 'Compra' : 'Venda'}</span> {nomeTipo[p.tipo]}{p.codigo && <small>{p.codigo}</small>}</td>
                  <td>{brl(p.strike)}</td>
                  <td>{p.tipo === 'acao' ? '—' : brl(p.premio)}</td>
                  <td>{p.qtd}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <PayoffEstrutura pernas={d.estrutura.pernas} spot={d.precoReferencia} />
        </section>

        <section class="invalida">
          <p class="rot">🚫 O que invalida o cenário</p>
          <p>{d.invalidacao}</p>
        </section>

        {d.resultado && (
          <section class="resultado">
            <p class="rot">🏁 Resultado do estudo</p>
            <p>{d.resultado}</p>
          </section>
        )}
      </aside>
    </div>

    {d.plano && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Preço-teto e plano de entrada</p>
        <h2 class="tit-bloco">{d.plano.titulo}</h2>
        <p class="paragrafo" set:html={negrito(d.plano.texto)} />
        <div class="tabela-wrap"><table class="plano">
          <thead><tr><th>Tranche</th><th>Entrada</th><th>Gatilho</th><th>Stop</th><th>Alvos</th><th>R/R</th></tr></thead>
          <tbody>
            {d.plano.tranches.map((t) => (
              <tr>
                <td><b>{t.nome}</b>{t.nota && <small>{t.nota}</small>}</td>
                <td class="num">{t.entrada}</td><td>{t.gatilho}</td><td class="num">{t.stop}</td>
                <td class="num">{t.alvos}</td><td class="num">{t.rr}</td>
              </tr>
            ))}
          </tbody>
        </table></div>
        {d.plano.nota && <p class="nota-bloco" set:html={negrito(d.plano.nota)} />}
      </section>
    )}

    {d.cenarios && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · Range para os próximos 6 meses</p>
        <h2 class="tit-bloco">{d.cenarios.titulo}</h2>
        <div class="tabela-wrap"><table class="cen">
          <thead><tr><th>Cenário</th><th>Prob.*</th><th>Faixa R$</th><th>Premissas</th></tr></thead>
          <tbody>
            {d.cenarios.linhas.map((c) => (
              <tr><td><span class={`pill-cen ${c.cenario.toLowerCase()}`}>{c.cenario}</span></td><td class="num">{c.prob}</td><td class="num">{c.faixa}</td><td>{c.premissas}</td></tr>
            ))}
          </tbody>
        </table></div>
        {d.cenarios.nota && <p class="nota-bloco" set:html={negrito(d.cenarios.nota)} />}
      </section>
    )}

    {d.gatilhos && (
      <section class="bloco">
        <p class="eyebrow">{++secao} · O que muda o estudo</p>
        <div class="gatilhos">
          <div><h3 class="pos">Melhora o quadro</h3><ul class="topicos">{d.gatilhos.melhora.map((f) => <li set:html={negrito(f)} />)}</ul></div>
          <div><h3 class="neg">Piora o quadro</h3><ul class="topicos">{d.gatilhos.piora.map((f) => <li set:html={negrito(f)} />)}</ul></div>
        </div>
      </section>
    )}

    {d.fontes && <p class="fontes" set:html={negrito(d.fontes)} />}

    {d.youtube && (
      <div class="video-embed">
        <iframe src={`https://www.youtube-nocookie.com/embed/${d.youtube}`} title={`Vídeo: ${d.title}`} loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    )}

    <AvisoAnalise compacto />

    {outras.length > 0 && (
      <nav class="outras">
        <h2>Outros estudos de {d.ticker}</h2>
        <ul>{outras.map((o) => <li><a href={`/analises/${o.id}/`}>{dataBR(o.data.data)} · {o.data.title}</a></li>)}</ul>
      </nav>
    )}
  </article>
</Base>

<style>
  .sobretitulo a { color: var(--coral); text-decoration: none; }
  .linha-ticker { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 0.6rem; }
  .ticker { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: #fff; background: var(--petroleo); padding: 2px 12px; border-radius: 10px; }
  .empresa { color: var(--texto-suave); font-weight: 500; }
  .status { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 999px; }
  .status.ativa { background: #d9f2e6; color: #166b46; }
  .status.encerrada { background: var(--borda); color: var(--texto-suave); }
  .status.invalidada { background: #fbe0e0; color: #a83232; }
  h1 { margin-top: 0.4em; }
  .ficha {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1px;
    background: var(--borda); border: 1px solid var(--borda); border-radius: var(--raio); overflow: hidden;
  }
  .ficha div { background: var(--bg-card); padding: 0.7rem 0.9rem; }
  .ficha span, .rot, .niveis span {
    display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; color: var(--texto-suave);
  }
  .ficha b { color: var(--destaque); font-size: 1rem; }
  .niveis { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-bottom: 1rem; }
  .niveis div { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
  .niveis span { margin-right: 4px; }
  .niveis b { font-family: var(--font-mono); font-size: 0.88rem; padding: 2px 8px; border-radius: 6px; }
  .res b { background: #fbe0e0; color: #a83232; }
  .rng b { background: rgba(14,74,85,0.1); color: var(--destaque); }
  .bloco { margin: 2.2rem 0; }
  .eyebrow {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--coral);
    margin: 0 0 0.7rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--borda);
  }
  .tabela-wrap { overflow-x: auto; border: 1px solid var(--borda); border-radius: var(--raio); background: var(--bg-card); }
  .tabela-wrap table { display: table; width: 100%; margin: 0; font-size: 0.9rem; }
  .tabela-wrap th { background: var(--giz); font-size: 0.78rem; }
  @media (prefers-color-scheme: dark) { .tabela-wrap th { background: #0e262c; } }
  .tabela-wrap td { white-space: normal; vertical-align: top; }
  .num { font-family: var(--font-mono); white-space: nowrap !important; }
  .ind { table-layout: fixed; min-width: 760px; }
  .ind th:nth-child(1) { width: 17%; } .ind th:nth-child(2) { width: 25%; } .ind th:nth-child(3) { width: 22%; } .ind th:nth-child(4) { width: 36%; }
  .ind td.num { white-space: normal !important; font-size: 0.84rem; line-height: 1.45; }
  .mapa { min-width: 520px; }
  .sinal { font-size: 0.8rem; }
  .sinal.alta { color: #1f8a5b; } .sinal.baixa { color: #d64545; } .sinal.neutro { color: var(--texto-suave); }
  .eventos { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .eventos li { display: grid; grid-template-columns: 92px 1fr; gap: 12px; background: var(--bg-card); border: 1px solid var(--borda); border-left: 4px solid var(--petroleo); border-radius: 10px; padding: 0.6rem 0.8rem; }
  .eventos .data { font-family: var(--font-mono); font-weight: 600; color: var(--coral); font-size: 0.88rem; }
  .eventos b { color: var(--destaque); }
  .eventos p { margin: 0.15rem 0 0; font-size: 0.92rem; line-height: 1.5; }
  @media (max-width: 560px) { .eventos li { grid-template-columns: 1fr; gap: 2px; } }
  .vp-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 18px; align-items: start; }
  @media (max-width: 900px) { .vp-grid { grid-template-columns: 1fr; } }
  .mapa .pill { display: inline-block; font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
  .pill.resistencia { background: #fbe0e0; color: #a83232; } .pill.suporte { background: #d9f2e6; color: #166b46; }
  .pill.pivo { background: var(--giz); color: var(--texto); border: 1px solid var(--borda); } .pill.vazio { background: #fff4d6; color: #8a6400; }
  .pill.preco { background: var(--petroleo); color: #fff; }
  .mapa tr.preco td { background: rgba(14,74,85,0.08); font-weight: 600; }
  .sup b { background: #d9f2e6; color: #166b46; }
  .corpo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: 28px; align-items: start; }
  @media (max-width: 900px) { .corpo { grid-template-columns: 1fr; } }
  .texto h2:first-child { margin-top: 0.6em; }
  .texto .eyebrow + :global(h2) { border-top: none; padding-top: 0; margin-top: 0.6em; }
  .lateral { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 12px; }
  @media (max-width: 900px) { .lateral { position: static; } }
  .lateral section { border-radius: var(--raio); padding: 1rem 1.1rem; }
  .estrutura { background: var(--petroleo); color: var(--creme); }
  .estrutura .rot { color: #cfe0e2; }
  .estrutura h2 { color: #fff; margin: 0.2em 0 0.3em; font-size: 1.5rem; border: none; padding: 0; }
  .racional { font-size: 0.93rem; line-height: 1.55; color: #e3eced; margin: 0 0 0.6rem; }
  .venc { font-size: 0.9rem; margin: 0 0 0.6rem; }
  .estrutura table { display: table; width: 100%; font-size: 0.85rem; margin: 0.4rem 0 0.9rem; table-layout: fixed; }
  .estrutura th, .estrutura td { padding: 0.45em 0.35em; min-width: 0; }
  .estrutura th:first-child, .estrutura td:first-child { width: 38%; }
  .estrutura th { color: #cfe0e2; font-size: 0.75rem; border-color: rgba(255,255,255,0.2); }
  .estrutura td { border-color: rgba(255,255,255,0.15); white-space: normal; font-family: var(--font-mono); }
  .lateral, .texto { min-width: 0; }
  .estrutura td:first-child { font-family: var(--font-texto); }
  .estrutura td small { display: block; font-family: var(--font-mono); color: #cfe0e2; font-size: 0.72rem; }
  .estrutura td .compra { color: #7be0ad; font-weight: 600; }
  .estrutura td .venda { color: #ffb4a6; font-weight: 600; }
  .estrutura :global(.payoff) { color: var(--texto); }
  .invalida { background: #fbe0e0; color: #6b1f1f; }
  .invalida .rot { color: #a83232; }
  .invalida p:last-child, .resultado p:last-child { margin: 0.3rem 0 0; font-size: 0.95rem; line-height: 1.5; }
  .resultado { background: var(--bg-card); border: 2px solid var(--petroleo); }
  .outras ul { padding-left: 1.2rem; }

---
import Base from '../../layouts/Base.astro';
import { MODULOS } from '../../data/conceitos.ts';
---
<Base title="Conceitos de opções na prática" description="Laboratório de conceitos do Opcionando: o prêmio pelos dois lados, o tempo, a volatilidade, as gregas e a probabilidade, numa operação real.">
  <section class="container-larga pagina">
    <p class="sobretitulo">Conceitos</p>
    <h1>Conceitos na prática</h1>
    <p class="intro">Teoria de opções tem em todo lugar. Aqui cada conceito aparece numa operação concreta, com preço real, e você mexe nos controles para ver o que acontece.</p>
    <ul class="grade-cards">
      <li>
        <a class="card-link" href="/conceitos/jornada-do-premio/">
          <span class="titulo">A jornada do prêmio</span>
          <span class="resumo">Uma opção real de BBAS3, comprador e vendedor, dia a dia: quanto do resultado veio do preço, do tempo e da volatilidade.</span>
        </a>
      </li>
      {MODULOS.map((m) => (
        <li>
          <a class="card-link" href={`/conceitos/${m.slug}/`}>
            <span class="titulo">{m.titulo}</span>
            <span class="resumo">{m.resumo}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

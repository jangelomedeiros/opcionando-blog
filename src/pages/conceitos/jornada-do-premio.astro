---
import '../../styles/catalogo.css';
import '../../styles/conceitos.css';
import Base from '../../layouts/Base.astro';
import Jornada from '../../components/conceitos/Jornada.tsx';
import { DISCLAIMER } from '../../consts';
import GRADE from '../../data/grades/bbas3-2026-11-13.json';
import CANDLES from '../../data/candles/bbas3-2026-11-12.json';
import { opcaoDaGrade, diasDaOpcao, trajetoriaCenario, trechosHistoricos, type TipoCenario } from '../../lib/conceitos/jornada.ts';

const call = opcaoDaGrade(GRADE as any, 'call');
const put = opcaoDaGrade(GRADE as any, 'put');
const dias = diasDaOpcao(call); // um passo por pregão até o vencimento (inclusive)
const reais = trechosHistoricos(CANDLES as any, dias, call.spot).map((t) => ({ ...t, grupo: 'real' as const }));
const CEN: [TipoCenario, string][] = [
  ['alta-lenta', 'Alta lenta (+8% até o vencimento)'],
  ['queda-brusca', 'Queda brusca (−10% em 2 dias)'],
  ['lateral', 'Lateral (±2%)'],
  ['gap-balanco', 'Gap depois do balanço (−9% de uma vez)'],
];
const cenarios = CEN.map(([id, nome]) => ({ id, nome, grupo: 'cenario' as const, precos: trajetoriaCenario(id, call.spot, dias) }));
const dados = { call, put, trajetorias: [...reais, ...cenarios] };
const br = (v: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const dataBr = (iso: string) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;
---
<Base title="Jornada do prêmio | Conceitos" description="Uma opção real de BBAS3 vista pelos dois lados, comprador e vendedor, dia a dia: de onde vem o resultado (preço, tempo e volatilidade) até o vencimento.">
  <section class="container-larga pagina">
    <p class="sobretitulo"><a href="/conceitos/">Conceitos</a></p>
    <h1>A jornada do prêmio</h1>
    <p class="intro">O mesmo prêmio, dois lados da mesa. O comprador paga para ter um direito; o vendedor recebe para assumir uma obrigação. Faça o tempo correr e veja, dia a dia, quanto do resultado veio do preço, quanto do tempo e quanto da volatilidade, para cada lado.</p>
    <div class="fig jp-fig">
      <Jornada client:only="preact" dados={dados} />
      <noscript>
        <div class="jp-estatico">
          <p><b>{call.ticker}</b>: CALL de BBAS3, strike R$ {br(call.strike)}, vencimento {dataBr(call.venc)}. Prêmio de entrada R$ {br(call.premio)} em {dataBr(call.data)} (ação a R$ {br(call.spot)}).</p>
          <p><b>Comprador</b>: paga R$ {br(call.premio)} e ganha o direito de comprar a ação a R$ {br(call.strike)}. No vencimento, só termina no lucro se a ação passar de R$ {br(call.strike + call.premio)} (strike + prêmio); até lá, o tempo trabalha contra ele.</p>
          <p><b>Vendedor</b>: recebe R$ {br(call.premio)} e assume a obrigação de vender a R$ {br(call.strike)}. O tempo trabalha a favor; uma alta forte trabalha contra.</p>
          <p>Ative o JavaScript para fazer o tempo correr e ver a decomposição do resultado dia a dia.</p>
        </div>
      </noscript>
    </div>
    <p class="nota">Entrada com preço real da grade de {dataBr(call.data)} (opcoes.net.br). A evolução é calculada por Black-Scholes (Selic de 15% a.a.) sobre cada trajetória: trechos reais do histórico de BBAS3, reescalados para começar no preço de entrada, ou cenários prontos. A decomposição é sequencial: em cada dia, primeiro move o preço, depois passa o tempo; a soma das partes é exatamente a variação do prêmio.</p>
    <p class="aviso-legal">{DISCLAIMER}</p>
  </section>
</Base>

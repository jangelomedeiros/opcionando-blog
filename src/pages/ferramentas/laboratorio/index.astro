---
import '../../../styles/laboratorio.css';
import Base from '../../../layouts/Base.astro';
import { DISCLAIMER } from '../../../consts';
import { ESTRUTURAS, POPS, FAM_COR, FAM_ORDEM, grafico, teoria, lerMercado, hoje, hojeIso } from '../../../lib/laboratorio';

const { meta, mercado } = lerMercado();
const hj = hojeIso();
const itens = ESTRUTURAS.map((e) => {
  const { spot0, at, comp0 } = teoria(e);
  const h = hoje(e, meta, mercado, hj);
  return { e, svg: grafico(at, spot0, { mini: true, comp: comp0 }), tem: h.tem, visao: POPS[e.pop]?.visao ?? '' };
});
const fams = FAM_ORDEM.filter((f) => itens.some((i) => i.e.familia === f));
const comReais = itens.filter((i) => i.tem).length;
---
<Base title="Laboratório de estruturas de opções" description="62 estruturas com opções na B3: montagem teórica, gráfico de payoff, break-even, probabilidade de lucro, POP e como montar hoje com valores reais de mercado.">
  <section class="container-larga pagina lab">
    <p class="sobretitulo">Laboratório</p>
    <h1>Laboratório de estruturas</h1>
    <p class="intro">{ESTRUTURAS.length} estruturas com opções sobre ações da B3. Cada uma traz a montagem teórica, o gráfico de payoff, os números principais, o procedimento operacional (POP) e a pergunta que importa: como montar isso hoje, com os preços reais do mercado?</p>
    <p class="nota">{comReais > 0 ? `${comReais} estruturas já com preços reais carregados.` : 'Preços reais ainda não carregados.'} Os exemplos teóricos usam BBAS3 como ativo-base.</p>

    <div class="filtros" role="group" aria-label="Filtrar por família">
      <button type="button" class="fbtn on" data-f="">Todas</button>
      {fams.map((f) => <button type="button" class="fbtn" data-f={f} style={`--fc:${FAM_COR[f]}`}>{f}</button>)}
    </div>

    {fams.map((f) => (
      <section class="familia" data-fam={f}>
        <h2 style={`--fc:${FAM_COR[f]}`}>{f}</h2>
        <ul class="lab-grid">
          {itens.filter((i) => i.e.familia === f).map((i) => (
            <li>
              <a class="lab-card" href={`/ferramentas/laboratorio/${i.e.id}/`} style={`--fc:${FAM_COR[f]}`}>
                <Fragment set:html={i.svg} />
                <span class="titulo">{i.e.nome}</span>
                {i.visao && <span class="resumo">{i.visao}</span>}
                {i.tem && <span class="selo coral">com preços reais</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="aviso-legal">{DISCLAIMER}</p>
  </section>
  <script is:inline>
    document.querySelectorAll('.fbtn').forEach(function (b) {
      b.addEventListener('click', function () {
        var f = b.getAttribute('data-f');
        document.querySelectorAll('.fbtn').forEach(function (x) { x.classList.toggle('on', x === b); });
        document.querySelectorAll('.familia').forEach(function (s) { s.hidden = !!f && s.getAttribute('data-fam') !== f; });
      });
    });
  </script>
</Base>

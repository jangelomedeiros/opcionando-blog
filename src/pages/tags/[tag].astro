---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`#${tag}`} description={`Artigos sobre ${tag} no blog Opcionando.`}>
  <section class="container" style="padding-top:2.6rem">
    <h1>#{tag}</h1>
    <div style="display:grid;gap:1.1rem">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>
